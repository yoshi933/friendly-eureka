{
  "manifest_version": 3,
  "name": "Better Classroom UX",
  "version": "0.1.0",
  "description": "Enhance Google Classroom with cross-stream search, pin, dashboard, push notifications, and UI improvements.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://classroom.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*"],
      "js": ["selectors.js", "storage.js", "content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Better Classroom UX"
  }
}
